# Cloudflare Pages redirects
# Docs: https://developers.cloudflare.com/pages/configuration/redirects/
# Syntax: <source> <destination> <status>
#   200 = rewrite (URL bar shows source, content from destination)
#   301 = permanent redirect (URL bar changes)

# ── Portafolio ↔ home (200 rewrite: same content, two URLs) ────────
# /portfolio/portafolio.html and /portfolio/portafolio serve the home gallery.
# Single source of truth: landing/portfolio/index.html
/portfolio/portafolio.html  /portfolio/index.html  200
/portfolio/portafolio       /portfolio/index.html  200

# ── Legacy SEO: /proyectos → /fotografia (301 permanent) ───────────
# Old portfoliobox/internal links keep working; search engines update.
/portfolio/proyectos.html   /portfolio/fotografia.html  301
/portfolio/proyectos        /portfolio/fotografia.html  301
