# Cloudflare Pages redirects
# Docs: https://developers.cloudflare.com/pages/configuration/redirects/
# Syntax: <source> <destination> <status>
#   200 = rewrite (URL bar shows source, content from destination)
#   301 = permanent redirect (URL bar changes)

# ── Legacy SEO: /proyectos → /fotografia (301 permanent) ───────────
# Old portfoliobox/internal links keep working; search engines update.
/portfolio/proyectos.html   /portfolio/fotografia.html  301
/portfolio/proyectos        /portfolio/fotografia.html  301

# ── Contact now lives on the main site (DM X / email) ──────────────
# The portfolio contact page redirects to the main landing's contact.
/portfolio/contacto.html    https://nicolasbiondi.com/   301
/portfolio/contacto         https://nicolasbiondi.com/   301

# Note: /portfolio/portafolio.html is generated at build time as a
# byte-identical copy of /portfolio/index.html (see .github/workflows/deploy.yml).
# Both URLs serve the same content from a single source.
